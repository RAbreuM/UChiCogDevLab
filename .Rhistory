library(gert)
library(gh)
# =============================================================================
# SETTINGS
# =============================================================================
parent_dir <- "/Volumes/BL-PSY-gunderson_lab/Main/Studies/2023_manynumbers/data/2025/BIDS_ManyNumbers"
collaborators <- c("duruleslie", "eagunder")
#"aaktanerciyes-silab", "elifob",  "yuyanfei31-create"
# Get all directories inside BIDS_ManyNumbers
directories <- list.dirs(
parent_dir,
recursive = FALSE,
full.names = TRUE
)
directories
#for (repo_dir in directories[62:length(directories)]) {
for (repo_dir in directories[83:83]) {
# Repository name = directory name
repo_name <- basename(repo_dir)
cat("\n============================================================\n")
cat("Processing:", repo_name, "\n")
cat("============================================================\n")
# ---------------------------------------------------------------------------
# Skip directories that already have a Git repository
# ---------------------------------------------------------------------------
if (dir.exists(file.path(repo_dir, ".git"))) {
cat("SKIPPING:", repo_name, "- Git repository already exists.\n")
next
}
# ---------------------------------------------------------------------------
# Set working directory
# ---------------------------------------------------------------------------
setwd(repo_dir)
# ---------------------------------------------------------------------------
# 1. Initialize Git repository
# ---------------------------------------------------------------------------
git_init(path = ".")
# ---------------------------------------------------------------------------
# 2. Create .gitignore
# ---------------------------------------------------------------------------
writeLines(
c(
"**/*.pdf",
"archive/"
),
".gitignore"
)
# ---------------------------------------------------------------------------
# 3. Stage files
# ---------------------------------------------------------------------------
files_to_add <- list.files(
".",
recursive = TRUE,
all.files = TRUE,
no.. = TRUE,
include.dirs = FALSE
)
files_to_add <- files_to_add[
!grepl("^archive/", files_to_add) &
!grepl("^\\.git/", files_to_add)
]
git_add(
files = c(".gitignore", files_to_add),
repo = "."
)
# ---------------------------------------------------------------------------
# 4. Commit
# ---------------------------------------------------------------------------
git_commit(
message = "Initial commit",
repo = "."
)
# ---------------------------------------------------------------------------
# 5. Rename branch to main
# ---------------------------------------------------------------------------
git_branch_move(
branch = "master",
new_branch = "main",
repo = "."
)
# ---------------------------------------------------------------------------
# 6. Create GitHub repository
# ---------------------------------------------------------------------------
repo <- gh(
"POST /user/repos",
name = repo_name,
private = FALSE
)
# ---------------------------------------------------------------------------
# 7. Add GitHub remote
# ---------------------------------------------------------------------------
git_remote_add(
url = repo$html_url,
name = "origin",
repo = "."
)
# ---------------------------------------------------------------------------
# 8. Push to GitHub
# ---------------------------------------------------------------------------
system2(
"git",
c("push", "-u", "origin", "main"),
stdout = TRUE,
stderr = TRUE
)
# ---------------------------------------------------------------------------
# 9. Add collaborators
# ---------------------------------------------------------------------------
for (user in collaborators) {
gh(
"PUT /repos/{owner}/{repo}/collaborators/{username}",
owner = "RAbreuM",
repo = repo_name,
username = user,
permission = "push"
)
cat("Added collaborator:", user, "\n")
}
cat("Finished:", repo_name, "\n")
}
